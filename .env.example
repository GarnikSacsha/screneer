APP_NAME=Altcoin Anomaly Screener
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5500"]
ALLOWED_HOSTS=["127.0.0.1","localhost"]

# Required when APP_ENV is production or staging. Generate a long random value.
ADMIN_API_KEY=
EXPENSIVE_RATE_LIMIT_REQUESTS=12
EXPENSIVE_RATE_LIMIT_WINDOW_SEC=60

POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://quant:replace-with-a-long-random-password@localhost:5432/quantdesk
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

RISK_AGENT_ENABLED=true
RISK_AGENT_MODEL=gpt-5.6
RISK_AGENT_TIMEOUT_SEC=30
RISK_AGENT_MAX_TURNS=3
RISK_AGENT_MAX_SNAPSHOT_AGE_MINUTES=30
OPENAI_API_KEY=

BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws
BINANCE_PREVIEW_CONCURRENCY=2
BINANCE_PARALLEL_SYMBOL_REQUESTS=false
BINANCE_REQUEST_PAUSE_MS=250
BINANCE_ENABLE_ORDERBOOK=false
BINANCE_KLINES_5M_LIMIT=288
BINANCE_EMA_KLINES_LIMIT=120
BYBIT_BASE_URL=https://api.bybit.com
OKX_BASE_URL=https://www.okx.com
